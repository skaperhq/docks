{
  "name": "skaper",
  "version": "0.1.1",
  "description": "A self-contained OpenAPI documentation and API request UI for Node.js routes.",
  "license": "MIT",
  "keywords": [
    "openapi",
    "api-documentation",
    "api-client",
    "node",
    "hono",
    "express"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/package",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "ws": "^8.21.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "npm run build:app && npm run build:package",
    "build:app": "vite build",
    "build:ui": "vite build --config vite.lib.config.ts",
    "build:package": "npm run build:ui && node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "package": "npm pack --cache /tmp/skaper-npm-cache",
    "test:package": "npm run build:package && node scripts/test-package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/search": "^6.7.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28",
    "lucide-react": "^1.21.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
